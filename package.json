{
  "name": "nexusftp-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite --port 5177\" \"wait-on tcp:5177 && cross-env VITE_DEV_SERVER_URL=http://localhost:5177 electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.nexusftp.app",
    "productName": "NexusFTP",
    "copyright": "Copyright © 2026 NexusFTP",
    "directories": {
      "output": "dist_electron",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.png"
    ],
    "icon": "public/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "Ttyyyyyoii",
        "repo": "nexusftp"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexusFTP",
      "installerIcon": "public/icon.png",
      "uninstallerIcon": "public/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "public/icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "NexusFTP ${version}",
      "contents": [
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 130, "y": 150, "type": "file" }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png",
      "category": "Network",
      "description": "Client FTP, SFTP et FTPS premium en ligne"
    }
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.7.0",
    "axios": "^1.6.8",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "lucide-vue-next": "^0.359.0",
    "marked": "^18.0.9",
    "pinia": "^2.1.7",
    "splitpanes": "^3.1.5",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.0.10",
    "workbox-window": "^7.4.1"
  }
}
